{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display, user_avatar %}

<div class="container mt-5">

  <!-- User Profile Information Card -->
  <div class="card col-lg-8 mx-auto">
    <div class="row g-0 align-items-center">
      <div class="col-md-12">
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            {{ user_avatar(user.id, username=user.username, profile_picture=user.profile_picture, size='120px') }}
            <h2 class="card-title mb-0">{{ user_display(user.username) }}</h2>
          </div>
          {% if session.get('user_id') == user.id %}
          <form action="{{ url_for('select_profile_badge') }}" method="POST" class="mb-3">
            <label for="profile-badge" class="form-label">Profile badge</label>
            <div class="d-flex gap-2">
              <select id="profile-badge" name="badge_key" class="form-select form-select-sm">
                <option value="">❌ No badge</option>
                {% for quest in quests if quest.completed %}
                <option value="{{ quest.key }}" {% if user.selected_badge == quest.key %}selected{% endif %}>
                  {{ quest.badge }} {{ quest.name }}
                </option>
                {% endfor %}
              </select>
              <button type="submit" class="btn btn-sm btn-primary">Save</button>
            </div>
          </form>
          {% endif %}
          {% if session.get('user_id') and session.get('user_id') != user.id %}
          <form action="{{ url_for('report_content', content_type='profile', item_id=user.id) }}" method="POST" class="mb-3">
            <button type="submit" class="btn btn-sm btn-danger">Report</button>
          </form>
          {% endif %}

          {% if session.user_id == user.id %}
          <form action="{{ url_for('upload_profile_picture', username=user.username) }}" method="POST" enctype="multipart/form-data" class="mb-3">
            <div class="d-flex align-items-center gap-2">
              <input type="file" name="profile_picture" accept="image/*" class="form-control form-control-sm">
              <button type="submit" class="btn btn-sm btn-primary">Upload</button>
            </div>
          </form>
          {% endif %}

          <p class="card-text text-muted mb-3">
            <strong>Location:</strong> {{ user.location or "N/A" }}<br>
            <strong>Birthdate:</strong> {{ user.birthdate or "N/A" }}<br>
            <strong>Joined:</strong> {{ user.created_at|datetimeformat }}
          </p>
          <p class="card-text">{{ user.profile or "No profile information provided." }}</p>

         {% if session.user_id and session.user_id != user.id %}
            <div class="my-3">
              {# The logic is now a simple boolean check #}
              {% if is_following %}
                <form action="{{ url_for('unfollow_user', user_id=user.id) }}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-secondary">Unfollow</button>
                </form>
              {% else %}
                <form action="{{ url_for('follow_user', user_id=user.id) }}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-primary">Follow</button>
                </form>
              {% endif %}
            </div>
          {% endif %}

          <div class="mt-4 d-flex">
            <div class="me-4">
              <a href="/u/{{ user.username }}/followers" class="text-decoration-none text-dark">
                <strong>{{ followers_count }}</strong> Followers
              </a>
            </div>
            <div>
              <a href="/u/{{ user.username }}/following" class="text-decoration-none text-dark">
                <strong>{{ following_count }}</strong> Following
              </a>
            </div>
            <div class="ms-4">
              {# This total counts reactions on this user's posts, not reactions they made. #}
              <strong>{{ reactions_count }}</strong> Reactions
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="my-5" aria-labelledby="quests-heading">
    <h3 id="quests-heading" class="text-center border-bottom pb-2 mb-4">Quests</h3>
    <div class="row g-3">
      {% for quest in quests %}
      <div class="col-md-6">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h4 class="h5">{{ quest.name }} {{ quest.badge }}</h4>
            <p class="mb-2">{{ quest.description }}</p>
            <div class="progress" role="progressbar"
                 aria-label="{{ quest.name }} quest progress"
                 aria-valuenow="{{ quest.progress }}" aria-valuemin="0"
                 aria-valuemax="{{ quest.target }}">
              <div class="progress-bar {% if quest.completed %}bg-success{% endif %}"
                   style="width: {{ quest.progress * 100 / quest.target }}%">
                {{ quest.progress }}/{{ quest.target }}
              </div>
            </div>
            <small class="text-muted d-block mt-2">
              {{ quest.completed_users }} users have completed this quest ({{ quest.completion_percent }}%)
            </small>
            {% if session.get('user_id') == user.id and (not quest.completed or quest.key in tracked_quest_keys) %}
            <form action="{{ url_for('set_quest_tracking', quest_key=quest.key, action='untrack' if quest.key in tracked_quest_keys else 'track') }}"
                  method="POST" class="mt-3">
              <button type="submit" class="btn btn-sm btn-primary">
                {% if quest.key in tracked_quest_keys %}Untrack{% else %}Track{% endif %}
              </button>
            </form>
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <h3 class="text-center border-bottom pb-2 my-5"><span>Latest Posts</span></h3>

  <div class="row g-3">
    {% for post in posts %}
    <div class="col-md-6">
      <div class="card h-100 shadow-sm card-hover">
        <a href="{{ url_for('post_detail', post_id=post.id) }}" class="text-decoration-none text-reset">
          <div class="card-body">
            <p class="card-text">{{ post.content|truncate(100, True, '...') }}</p>
            {% if session.get('username') == 'admin' %}
            <small class="d-block text-muted">
              Content score: {{ post.content_score }} |
              Post risk score: {{ post.post_risk_score }} |
              User risk score: {{ post.user_risk_score }} |
              Risk level:
              {% if post.risk_level == "HIGH" %}
                <span class="badge bg-danger">HIGH</span>
              {% elif post.risk_level == "MEDIUM" %}
                <span class="badge bg-warning text-dark">MEDIUM</span>
              {% elif post.risk_level == "LOW" %}
                <span class="badge bg-info text-dark">LOW</span>
              {% else %}
                <span class="badge bg-secondary">NONE</span>
              {% endif %}
            </small>
            {% endif %}
            {% if post.image %}
            <img src="{{ url_for('static', filename=post.image) }}" alt="Post image" class="img-fluid rounded border mt-2" style="max-height: 220px; width: 100%; object-fit: cover;">
            {% endif %}
            <small class="text-muted d-block mt-2">Posted on {{ post.created_at|datetimeformat }}</small>
          </div>
        </a>
        {% if session.get('user_id') and session.get('user_id') != post.user_id %}
        <div class="px-3 pb-3">
          <form action="{{ url_for('report_content', content_type='post', item_id=post.id) }}" method="POST">
            <button type="submit" class="btn btn-sm btn-danger">Report</button>
          </form>
        </div>
        {% endif %}
      </div>
    </div>
    {% else %}
    <div class="col-12">
      <p class="text-center text-muted">No posts yet.</p>
    </div>
    {% endfor %}
  </div>

  <!-- User's Latest Comments Section -->
  <h3 class="text-center border-bottom pb-2 my-5"><span>Latest Comments</span></h3>

  <div class="row g-3">
    {% for comment in comments %}
    <div class="col-md-6">
      <div class="card h-100 shadow-sm card-hover">
        <!-- The link now goes to the post the comment is on -->
        <a href="{{ url_for('post_detail', post_id=comment.post_id) }}" class="text-decoration-none text-reset">
          <div class="card-body">
            <!-- Display the comment content -->
            <p class="card-text">{{ comment.content|truncate(100, True, '...') }}</p>
            <!-- Updated text to show it's a comment -->
            <small class="text-muted">Commented on {{ comment.created_at|datetimeformat }}</small>
          </div>
        </a>
        {% if session.get('user_id') and session.get('user_id') != comment.user_id %}
        <div class="px-3 pb-3">
          <form action="{{ url_for('report_content', content_type='comment', item_id=comment.id) }}" method="POST">
            <button type="submit" class="btn btn-sm btn-danger">Report</button>
          </form>
        </div>
        {% endif %}
      </div>
    </div>
    {% else %}
    <div class="col-12">
      <p class="text-center text-muted">No comments yet.</p>
    </div>
    {% endfor %}
  </div>

</div>
{% endblock %}
