{% macro user_display(user_id) %}
  {% set color = loop_color(user_id) %}
  <a href="/u/{{ user_id }}" class="text-decoration-none" style="color: {{ color }};">
    <span>@{{ display_username(user_id) }}</span>
  </a>
{% endmacro %}

{% macro user_avatar(user_id, username=None, profile_picture=None, size='42px') %}
  {% set name = username or user_id %}
  {% if profile_picture %}
    <img src="{{ url_for('static', filename=profile_picture) }}"
         alt="{{ name }} profile picture"
         class="rounded-circle border shadow-sm me-2"
         style="width: {{ size }}; height: {{ size }}; object-fit: cover;">
  {% else %}
    {% set color = loop_color(user_id) %}
    <div class="rounded-circle border shadow-sm me-2 d-inline-flex align-items-center justify-content-center"
         style="width: {{ size }}; height: {{ size }}; background-color: {{ color }}; color: white; font-weight: bold; font-size: calc({{ size }} * 0.45);">
      {{ name[:1]|upper }}
    </div>
  {% endif %}
{% endmacro %}

{% macro quest_tracker_panel(quests) %}
  {% if quests %}
  <aside class="position-fixed start-0 top-50 translate-middle-y ms-2"
         style="width: min(250px, 42vw); max-height: 75vh; overflow-y: auto; z-index: 1020;"
         aria-label="Tracked quests">
    <div class="card shadow">
      <div class="card-header fw-bold">Quest Tracker</div>
      <div class="card-body p-2">
        {% for quest in quests %}
        <div class="{% if not loop.first %}border-top pt-2 mt-2{% endif %}">
          <div class="fw-semibold">{{ quest.badge }} {{ quest.description }}</div>
          <div class="progress mt-2" role="progressbar"
               aria-label="{{ quest.name }} quest progress"
               aria-valuenow="{{ quest.progress }}" aria-valuemin="0"
               aria-valuemax="{{ quest.target }}">
            <div class="progress-bar {% if quest.completed %}bg-success{% endif %}"
                 style="width: {{ quest.progress * 100 / quest.target }}%">
              {{ quest.progress }}/{{ quest.target }}
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </aside>
  {% endif %}
{% endmacro %}
