{% macro user_display(user_id) %}
  {% set color = loop_color(user_id) %}
  <a href="/u/{{ user_id }}" class="text-decoration-none" style="color: {{ color }};">
    <span>@{{ user_id }}</span>
  </a>
{% endmacro %}

{% macro user_avatar(user_id, username=None, profile_picture=None, size='42px') %}
  {% set name = username or user_id %}
  {% if profile_picture %}
    <img src="{{ url_for('static', filename=profile_picture) }}"
         alt="{{ name }} profile picture"
         class="rounded-circle border shadow-sm me-2"
         style="width: {{ size }}; height: {{ size }}; object-fit: cover;">
  {% else %}
    {% set color = loop_color(user_id) %}
    <div class="rounded-circle border shadow-sm me-2 d-inline-flex align-items-center justify-content-center"
         style="width: {{ size }}; height: {{ size }}; background-color: {{ color }}; color: white; font-weight: bold; font-size: calc({{ size }} * 0.45);">
      {{ name[:1]|upper }}
    </div>
  {% endif %}
{% endmacro %}
